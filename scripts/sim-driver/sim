#!/bin/zsh
# Simulator driver for the iOS shell, so a session can check the shell on a
# simulator with no person: it builds and installs the shell against the local
# Supabase stack, signs in a local fixture pair, folds and rotates with `ax`,
# and taps, scrolls and reads the page through an XCUITest runner
# (RunnerUITests/Drive.swift); it also answers the permission alert, pushes,
# and reads banners, Notification Center and the badge (Notify.swift), for
# the shell or, with --host, the runner's own host app. It also lists an app's
# scheduled (pending) local notifications from the simulator's own
# UserNotifications files (pending.py), and has the host schedule and remove
# requests on command so that reader is proven against known ones. `sim help`
# lists the commands.
#
# Every build happens in a staged copy outside the repo, in $SIM_DRIVER_WORK
# (default ~/Library/Caches/my-love-sim-driver/<checkout>-<hash>, one per
# checkout, so two stories in two worktrees, each on its own simulator clone,
# never share a stage, runner, log or serve.pid): `cap sync` copies dist/ into
# the app and `npx wrangler deploy` ships whatever dist/ holds, so a test build
# never touches the repo's dist/ or ios/App/App/public/; and
# ios/App/CapApp-SPM resolves ../../../node_modules, which a loop worktree
# lacks. The stage has its own node_modules.
#
# Needs: ax and xcodegen on PATH (`ax doctor` all ok), Device Hub open on the
# current Space, the Mac unlocked, and `supabase start` for the local stack.

setopt errexit nounset pipefail

TOOL=${0:A:h}
REPO=$(git -C "$TOOL" rev-parse --show-toplevel)
WORK=${SIM_DRIVER_WORK:-$HOME/Library/Caches/my-love-sim-driver/${REPO:t}-$(print -rn -- $REPO | shasum | cut -c1-8)}
BUNDLE=dev.sallvain.mylove
# The first pair (seeded), the second (no rows), then the unlinked pair (no
# partner, no requests): signin's targets in order.
EMAILS=(simdriver@test.example.com simdriver-partner@test.example.com
  simdriver-other@test.example.com simdriver-other-partner@test.example.com
  simdriver-unlinked@test.example.com simdriver-unlinked-other@test.example.com)
# A shell that must stay on its own web code checks an address nothing
# answers: a failed check leaves it on the build it has (story 7's Setup).
DEAD_UPDATE_URL=http://127.0.0.1:9/updates/latest.json
DEVICE_ARG=${SIM_DEVICE:-}
UDID=

usage() {
  cat <<'EOF'
usage: sim [--device UDID|NAME] COMMAND [ARGS]

Shell:
  build [--from REV] [--readout] [--update-port N]
                         Build the shell from the working tree (or REV) in a
                         stage outside the repo, uninstall the old one, install
                         and launch. --readout adds story 7's readout;
                         --update-port points its live-update check at
                         http://127.0.0.1:N (else nothing answers it).
  serve-update [--port N] [--readout]
                         Package the working tree as a live update and serve it
                         on 127.0.0.1:N (default 8790) in the background.
  serve-update --stop    Stop that server.
  launch                 Launch the shell, or bring it to the front.
  background             Press Home (Device Hub's button, through ax).
  uninstall              Remove the shell and its data.

Accounts (local stack only):
  provision              Create or reset the fixture accounts: Casey and Jessie,
                         linked and seeded so every view scrolls; Harper and
                         Morgan, linked, love notes wiped, nothing seeded; Riley
                         and Quinn, unlinked, partner requests deleted.
  dates kinds|many|clear
                         Set the dates the date reminders are planned from, for
                         Casey and Jessie only. kinds: one date of each kind,
                         3 to 8 days ahead. many: 50 events and 10 anniversaries
                         (70 reminders). clear: remove every date. kinds and many
                         first remove the seeded events. sim provision restores
                         only those events, not anniversaries, couple settings or
                         birthdays: run sim dates clear, then sim provision, to
                         get back the provisioned state.
  signin [partner|other|other-partner|unlinked|unlinked-other] [--decline-push]
                         Sign in through the login form (default: Casey;
                         partner: Jessie; other: Harper; other-partner: Morgan;
                         unlinked: Riley; unlinked-other: Quinn). The runner
                         answers a notification permission alert Allow when it
                         next touches the app; --decline-push answers it Don't
                         Allow instead (after sim permission reset).
  signout                Sign out through Settings and wait for the login form.

Device:
  pose closed|partial|open   Fold or unfold (ax pose).
  rotate [N]                 Rotate a quarter turn N times: right (ax rotate),
                             or left where Device Hub has only Rotate Left.
  state                      Pose, active display and orientation (ax state).
  screenshot PATH [--display inner|outer]
                             Save a PNG of a display (default: the active one).

Page (points from the web view's top-left):
  tap X Y                Tap a page point.
  scroll up|down         Swipe the web view.
  dump                   One JSON line: the web view's frame and its elements.
  readout                The readout's lines.

Notifications (the shell, or with --host the runner's host app, "Runner"):
  permission allow|deny [--host]
                         Bring the app to the front (the host asks when
                         launched), tap Allow or Don't Allow on the alert;
                         with --host, print its status (authorized, denied).
  permission reset [--host]
                         Uninstall and reinstall the app so it asks again
                         (the shell from the last sim build's App.app; it
                         loses its sign-in, so run sim signin again).
  push FILE [--host]     Send FILE, JSON with an aps object (simctl push).
  banner FILE [--tap cold|background | --front] [--host]
                         Put Settings in front, push FILE, print the banner's
                         label. --tap taps it, the app first terminated
                         (cold) or launched (background), and prints the
                         app's state before and after. --front puts the app
                         itself in front instead of Settings, pushes FILE and
                         watches: the shell shows no banner for a foreground
                         push, so a pass ends in "no banner" (exit 1). It
                         cannot be combined with --tap (exit 2).
  center [--host]        The app's Notification Center groups as one JSON
                         line: each group's text (its newest notification's
                         title and body) and notification count.
                         Unfolds the Duo and turns it to portrait to read
                         (proven with 8 groups), then puts the pose and
                         orientation back; a folded landscape comes back
                         only when the shell, the host, Settings or Safari
                         was in front. It ends on the Home Screen, except
                         that a folded-landscape start gets its front app
                         back.
  badge [--host]         The app icon's badge ("3 new items"), or none.
  pending [BUNDLE|--host]
                         The app's scheduled (pending) local notifications as
                         one JSON line, sorted by identifier: an array of
                         {identifier, title, body, threadId, trigger}, where
                         trigger is {type:"calendar", dateComponents:{only
                         those set}, repeats} or {type:"interval", seconds,
                         repeats}. Default: the shell; BUNDLE names another.
                         Decoded from the simulator's own files, so it needs
                         no runner step; [] when the app has none. It exits 1,
                         naming the record and key, on a record it does not
                         recognise, and prints nothing then.
  schedule FILE          Have the host schedule the requests in FILE (JSON
                         array; scripts/sim-driver/fixtures/host-requests.json
                         is a known-good one) and return once pending --host
                         lists them. Same identifier replaces. Launches the
                         host, so it comes to the front. The host needs
                         permission (permission allow --host); exit 1 says so.
  unschedule ID...       Have the host remove those pending requests and
                         return once pending --host no longer lists them.
                         Launches the host, so it comes to the front.

The device is --device, else $SIM_DEVICE, else the only booted simulator.
SIM_SUPABASE_URL overrides the local stack's URL (default: .env.test's).
SIM_IDLE_NAMES="Class,method,method" replaces the private XCUITest names the
center patches to skip idle waits (to check the warning).
Work dir: $SIM_DRIVER_WORK, default ~/Library/Caches/my-love-sim-driver/
<checkout name>-<hash of its path>, one per checkout.
EOF
}

# die's code is kept in SIM_EXIT too: an EXIT trap set in a function (center's
# restore) sees $? as 0 after exit, so it reads the code from here.
SIM_EXIT=0
die() { local code=$1; shift; print -u2 -- "sim: $*"; SIM_EXIT=$code; exit $code; }
# Progress goes to stderr, so stdout carries only results (dump's JSON).
say() { print -u2 -- "sim: $*"; }

# Runs one named stage with its output in $WORK/logs/<name>.log; on failure
# prints the log's tail and exits naming the stage.
stage() {
  local name=$1; shift
  local log=$WORK/logs/$name.log
  mkdir -p $WORK/logs
  say "$name..."
  if ! "$@" >$log 2>&1; then
    tail -n 25 $log >&2
    die 1 "$name failed (full log: $log)"
  fi
}

# ---- device ----------------------------------------------------------------

# --device, else $SIM_DEVICE, else the only booted simulator. Ambiguity
# (two booted, or a name on two runtimes) exits 2 with the candidates.
resolve_device() {
  [[ -n $UDID ]] && return
  local out code=0
  out=$(xcrun simctl list devices -j | node -e '
    const want = process.argv[1];
    const all = Object.entries(JSON.parse(require("fs").readFileSync(0, "utf8")).devices)
      .flatMap(([rt, ds]) => ds.filter((d) => d.isAvailable)
        .map((d) => ({ ...d, rt: rt.replace(/.*SimRuntime\./, "") })));
    let pick = want
      ? all.filter((d) => d.udid === want || d.name === want)
      : all.filter((d) => d.state === "Booted");
    if (want && pick.length > 1 && pick.some((d) => d.state === "Booted"))
      pick = pick.filter((d) => d.state === "Booted");
    const line = (d) => `${d.udid}  ${d.name} (${d.rt}) ${d.state}`;
    if (pick.length === 1) { console.log(pick[0].udid); process.exit(0); }
    if (pick.length === 0) {
      console.log(want ? `no simulator named or numbered ${want}` : "no booted simulator; boot one or pass --device");
      process.exit(4);
    }
    console.log("more than one simulator matches; pass --device or set SIM_DEVICE:\n" + pick.map(line).join("\n"));
    process.exit(2);
  ' "$DEVICE_ARG") || code=$?
  (( code == 0 )) || die $code "$out"
  UDID=$out
}

# grep reads all input: -q exits on the first match, and under pipefail the
# producer's SIGPIPE would then fail the pipeline.
booted() { xcrun simctl list devices | grep "$UDID) (Booted)" >/dev/null; }

require_booted() {
  resolve_device
  booted || die 4 "simulator $UDID is not booted"
}

# ---- local stack -------------------------------------------------------------

supabase_url() {
  if [[ -n ${SIM_SUPABASE_URL:-} ]]; then print -- $SIM_SUPABASE_URL; return; fi
  sed -n 's/^VITE_SUPABASE_URL=//p' $REPO/.env.test
}

# Refuses anything but a local URL, then checks the stack answers.
require_stack() {
  local url=$(supabase_url)
  [[ $url == http://127.0.0.1:* || $url == http://localhost:* ]] ||
    die 1 "refusing $url: the driver uses the local stack only"
  curl -sf -m 5 -o /dev/null "$url/auth/v1/health" ||
    die 1 "the local stack does not answer at $url: run supabase start"
}

# ---- runner ----------------------------------------------------------------

RUNNER=$WORK/runner

# Regenerates and rebuilds the XCUITest runner when its sources are newer
# than the last build.
ensure_runner() {
  local stamp=$RUNNER/built.stamp
  if [[ -f $stamp && -d $RUNNER/dd/Build/Products ]] &&
    [[ -z $(find $TOOL/project.yml $TOOL/Runner $TOOL/RunnerUITests -newer $stamp -print -quit) ]]; then
    return
  fi
  say "runner sources changed since the last build; regenerating"
  rm -rf $RUNNER/src
  mkdir -p $RUNNER/src
  # Stamped before the copy, so an edit made during it still counts as newer.
  touch $RUNNER/building.stamp
  cp -R $TOOL/project.yml $TOOL/Runner $TOOL/RunnerUITests $RUNNER/src/
  stage xcodegen xcodegen generate --spec $RUNNER/src/project.yml --quiet
  stage runner-build xcodebuild build-for-testing -project $RUNNER/src/SimDriver.xcodeproj \
    -scheme RunnerUITests -destination "id=$UDID" -derivedDataPath $RUNNER/dd
  mv $RUNNER/building.stamp $stamp
}

# Starts one runner step, Drive/testDrive or Notify/testStep, with ACTION
# in its environment and its output in $WORK/logs/<class>.log; with BG=1 in
# the background, its pid in $STEP_PID.
STEP_PID=
start_step() {
  local class=$1 action=$2 log=$WORK/logs/${(L)1}.log
  local method=testStep
  [[ $class == Drive ]] && method=testDrive
  local -a cmd=(xcodebuild test-without-building
    -project $RUNNER/src/SimDriver.xcodeproj -scheme RunnerUITests
    -destination "id=$UDID" -derivedDataPath $RUNNER/dd
    -only-testing:RunnerUITests/$class/$method)
  mkdir -p $WORK/logs
  # Emptied here, not by the child's redirect: banner polls this log for
  # "watching" at once, and an earlier run's line must not match.
  : >$log
  if [[ ${BG:-} == 1 ]]; then
    TEST_RUNNER_ACTION=$action TEST_RUNNER_IDLE_NAMES=${SIM_IDLE_NAMES:-} $cmd >$log 2>&1 &
    STEP_PID=$!
  else
    TEST_RUNNER_ACTION=$action TEST_RUNNER_IDLE_NAMES=${SIM_IDLE_NAMES:-} $cmd >$log 2>&1
  fi
}

# Prints a finished step's lines without their prefix (DRIVE, NOTIFY) and,
# when CODE is non-zero, why it failed, then exits naming the step.
finish_step() {
  local class=$1 name=$2 code=$3 log=$WORK/logs/${(L)1}.log
  sed -n "s/^${(U)class} //p" $log
  if (( code != 0 )); then
    # A failure with no assertion (the runner never started, say) shows the
    # log's tail instead, so it is never silent.
    local -a why
    why=(${(f)"$(grep -E 'error:|XCTAssert' $log || true)"})
    if (( $#why )); then print -rl -- ${why[1,5]} >&2; else tail -n 15 $log >&2; fi
    die 1 "${(L)class} step '$name' failed (full log: $log)"
  fi
}

# Runs one Drive step and prints its DRIVE lines without the prefix.
drive() {
  require_booted
  ensure_runner
  local code=0
  start_step Drive "$*" || code=$?
  finish_step Drive $1 $code
}

# ---- stage and build ---------------------------------------------------------

# Fills a stage with the working tree (no REV) or REV, keeping its
# node_modules, and runs npm ci only when package-lock.json changed.
sync_stage() {
  local dir=$1 rev=${2:-}
  mkdir -p $dir
  find $dir -mindepth 1 -maxdepth 1 ! -name node_modules -exec rm -rf {} +
  if [[ -n $rev ]]; then
    git -C $REPO archive $rev | tar -x -C $dir
  else
    git -C $REPO ls-files -co --exclude-standard -z |
      rsync -a --from0 --files-from=- --ignore-missing-args $REPO/ $dir/
  fi
  local lock=$(shasum -a 256 $dir/package-lock.json | cut -d' ' -f1)
  if [[ $(cat $dir/node_modules/.sim-driver-lock 2>/dev/null) != $lock ]]; then
    stage npm-ci zsh -c "cd ${(q)dir} && npm ci --no-audit --no-fund"
    print -- $lock >$dir/node_modules/.sim-driver-lock
  fi
}

# Builds the web code in a stage against .env.test. Inherited VITE_* values
# are dropped first: Vite gives process.env priority over .env.test, and
# fnox's would point the bundle at production.
build_web() {
  local dir=$1 id=$2 update_url=$3 readout=$4
  stage vite zsh -c '
    for v in ${(k)parameters[(I)VITE_*]}; do unset $v; done
    [[ -n ${SIM_SUPABASE_URL:-} ]] && export VITE_SUPABASE_URL=$SIM_SUPABASE_URL
    cd $1 && GITHUB_SHA=$2 VITE_LIVE_UPDATE_URL=$3 npx vite build --mode test' \
    sim-vite $dir $id $update_url
  if [[ $readout == 1 ]]; then
    node -e '
      const fs = require("fs");
      const [file, readout] = process.argv.slice(1);
      const html = fs.readFileSync(file, "utf8");
      if (!html.includes("</head>")) process.exit(1);
      fs.writeFileSync(file, html.replace("</head>", fs.readFileSync(readout, "utf8") + "</head>"));
    ' $dir/dist/index.html $TOOL/readout.html || die 1 "readout: no </head> in $dir/dist/index.html"
    say "readout injected into the stage's dist/index.html"
  fi
}

cmd_build() {
  local rev= readout=0 port=
  while (( $# )); do
    case $1 in
      --from) rev=${2:?--from needs a revision}; shift 2 ;;
      --readout) readout=1; shift ;;
      --update-port) port=${2:?--update-port needs a port}; shift 2 ;;
      *) die 2 "build: unknown option $1" ;;
    esac
  done
  [[ -z $port || $port == <1-65535> ]] || die 2 "build: --update-port takes a port number"
  if [[ -n $rev ]]; then
    git -C $REPO rev-parse --verify --quiet "$rev^{commit}" >/dev/null ||
      die 1 "build: unknown revision $rev"
  fi
  require_booted
  require_stack

  local dir id update_url=$DEAD_UPDATE_URL
  if [[ -n $rev ]]; then
    dir=$WORK/stage/rev
    id=sim-$(git -C $REPO rev-parse --short "$rev^{commit}")-$(date +%s)
  else
    dir=$WORK/stage/tree
    id=sim-tree-$(date +%s)
  fi
  [[ -n $port ]] && update_url=http://127.0.0.1:$port/updates/latest.json
  say "staging ${rev:-the working tree} in $dir"
  sync_stage $dir $rev
  build_web $dir $id $update_url $readout
  stage cap-sync zsh -c "cd ${(q)dir} && npx cap sync ios"
  if [[ -n $port ]]; then
    # The updater refuses http unless told otherwise; the stage only.
    node -e '
      const fs = require("fs");
      const f = process.argv[1];
      const c = JSON.parse(fs.readFileSync(f, "utf8"));
      c.plugins = c.plugins || {};
      c.plugins.CapacitorUpdater = { ...c.plugins.CapacitorUpdater, httpsOnly: false };
      fs.writeFileSync(f, JSON.stringify(c, null, "\t") + "\n");
    ' $dir/ios/App/App/capacitor.config.json
    say "httpsOnly: false in the stage's capacitor.config.json"
  fi
  stage xcodebuild xcodebuild -project $dir/ios/App/App.xcodeproj -scheme App \
    -configuration Debug -destination "id=$UDID" -derivedDataPath $WORK/derived/app build
  local app=$WORK/derived/app/Build/Products/Debug-iphonesimulator/App.app
  [[ -d $app ]] || die 1 "xcodebuild: no App.app at $app"
  # A reinstall keeps the data container, and with it any bundle the updater
  # downloaded earlier, so the old shell goes first.
  stage simctl-uninstall xcrun simctl uninstall $UDID $BUNDLE
  stage simctl-install xcrun simctl install $UDID $app
  stage simctl-launch xcrun simctl launch $UDID $BUNDLE
  say "installed $id on $UDID (readout: $readout, update URL: $update_url)"
}

# ---- live update -------------------------------------------------------------

SERVE_PID=$WORK/serve.pid

# Serves a folder on 127.0.0.1 with the headers public/_headers gives
# /updates/* on the live site: the shell's fetch is cross-origin.
SERVE_PY='
import functools, http.server, sys
class Handler(http.server.SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "capacitor://localhost")
        self.send_header("Cache-Control", "no-cache")
        super().end_headers()
port, root = int(sys.argv[1]), sys.argv[2]
http.server.ThreadingHTTPServer(("127.0.0.1", port), functools.partial(Handler, directory=root)).serve_forever()
'

# True when $SERVE_PID names a live process running SERVE_PY, so a stale
# pid that another process has since taken is never killed.
serve_running() {
  [[ -f $SERVE_PID ]] || return 1
  local cmd
  cmd=$(ps -p $(cat $SERVE_PID) -o command= 2>/dev/null) || return 1
  [[ $cmd == *ThreadingHTTPServer* ]]
}

cmd_serve_update() {
  local port=8790 readout=0
  while (( $# )); do
    case $1 in
      --stop)
        if serve_running && kill $(cat $SERVE_PID) 2>/dev/null; then
          say "stopped the update server (pid $(cat $SERVE_PID))"
        else
          say "no update server running"
        fi
        rm -f $SERVE_PID
        return ;;
      --port) port=${2:?--port needs a number}; shift 2 ;;
      --readout) readout=1; shift ;;
      *) die 2 "serve-update: unknown option $1" ;;
    esac
  done
  [[ $port == <1-65535> ]] || die 2 "serve-update: --port takes a port number"
  serve_running &&
    die 1 "the driver's update server already runs (pid $(cat $SERVE_PID)): sim serve-update --stop stops it"
  require_stack
  if lsof -nP -iTCP:$port -sTCP:LISTEN >/dev/null 2>&1; then
    die 1 "port $port is busy"
  fi
  local dir=$WORK/stage/tree base=http://127.0.0.1:$port id=sim-tree-$(date +%s)
  say "staging the working tree in $dir"
  sync_stage $dir
  build_web $dir $id $base/updates/latest.json $readout
  stage package-live-update zsh -c 'cd $1 && GITHUB_SHA=$2 UPDATE_BASE_URL=$3 scripts/package-live-update.sh' \
    sim-package $dir $id $base
  rm -rf $WORK/serve
  cp -R $dir/dist $WORK/serve
  nohup python3 -I -c "$SERVE_PY" $port $WORK/serve >$WORK/logs/serve.log 2>&1 &!
  print -- $! >$SERVE_PID
  local tries=0
  until curl -sf -m 2 -o /dev/null $base/updates/latest.json; do
    (( ++tries < 20 )) || { cmd_serve_update --stop; die 1 "update server did not start (log: $WORK/logs/serve.log)"; }
    sleep 0.25
  done
  say "serving $id at $base/updates/latest.json (pid $(cat $SERVE_PID); stop with sim serve-update --stop)"
}

# ---- accounts ----------------------------------------------------------------

# supabase status reads the project from the current directory, so it runs in
# the repo whatever directory sim was called from.
stack_secret() {
  (cd $REPO && supabase status -o env 2>/dev/null) | sed -n 's/^SECRET_KEY="\(.*\)"$/\1/p'
}

cmd_provision() {
  require_stack
  local key=$(stack_secret)
  [[ -n $key ]] || die 1 "supabase status gave no SECRET_KEY: run supabase start"
  (cd $REPO && SIM_SUPABASE_URL=$(supabase_url) SIM_SUPABASE_SECRET_KEY=$key \
    node scripts/sim-driver/provision.ts) || die 1 "provision failed"
}

cmd_dates() {
  [[ ${1:-} == (kinds|many|clear) && $# -eq 1 ]] || die 2 "dates takes kinds, many or clear"
  require_stack
  local key=$(stack_secret)
  [[ -n $key ]] || die 1 "supabase status gave no SECRET_KEY: run supabase start"
  (cd $REPO && SIM_SUPABASE_URL=$(supabase_url) SIM_SUPABASE_SECRET_KEY=$key \
    node scripts/sim-driver/dates.ts $1) || die 1 "dates failed"
}

cmd_signin() {
  local decline=''
  if [[ ${@[-1]:-} == --decline-push ]]; then
    decline=decline-push
    set -- ${@[1,-2]}
  fi
  local which=${1:-}
  require_stack
  local email
  case $which in
    '') email=${EMAILS[1]} ;;
    partner) email=${EMAILS[2]} ;;
    other) email=${EMAILS[3]} ;;
    other-partner) email=${EMAILS[4]} ;;
    unlinked) email=${EMAILS[5]} ;;
    unlinked-other) email=${EMAILS[6]} ;;
    *) die 2 "signin takes nothing, 'partner', 'other', 'other-partner', 'unlinked' or 'unlinked-other'" ;;
  esac
  local password
  password=$(node --input-type=module -e '
    const m = await import(process.argv[1]); console.log(m.TEST_USER_PASSWORD);
  ' $REPO/tests/support/test-credentials.ts)
  drive signin $email $password $decline
}

# ---- page --------------------------------------------------------------------

cmd_readout() {
  local json
  json=$(drive dump) || exit $?
  print -r -- $json | node -e '
    const doc = JSON.parse(require("fs").readFileSync(0, "utf8"));
    const box = doc.elements.find((e) => e.label.includes("inset T/R/B/L"));
    if (!box) { console.error("sim: no readout on screen (build with --readout)"); process.exit(1); }
    console.log(box.label);
  '
}

# Device Hub shows Rotate Right for the Duo but only Rotate Left for the
# iPhone 17, and ax rotate presses Rotate Right; there, press Rotate Left and
# wait for ax state's orientation to change (portraitUpsideDown is a step).
cmd_rotate() {
  local times=$1
  local controls
  controls=$(ax controls --device $UDID)
  if print -r -- $controls | grep -x 'Rotate Right' >/dev/null; then
    ax rotate $times --device $UDID
    return
  fi
  local i from to tries
  for (( i = 0; i < times; i++ )); do
    from=$(ax state --device $UDID | sed -n 's/^orientation: //p')
    ax control 'Rotate Left' --device $UDID >/dev/null
    tries=0
    until to=$(ax state --device $UDID | sed -n 's/^orientation: //p'); [[ $to != $from ]]; do
      (( ++tries < 20 )) || die 5 "rotate: orientation stayed $from"
      sleep 0.25
    done
    print -- "rotated left: $from to $to"
  done
}

cmd_screenshot() {
  local out=${1:?screenshot needs a PATH} which=
  shift
  if (( $# )); then
    [[ $1 == --display && ( ${2:-} == inner || ${2:-} == outer ) ]] ||
      die 2 "screenshot: --display takes inner or outer"
    which=$2
  fi
  require_booted
  # The phone's screens are the display-class-0 ports; on the Duo the larger
  # is the inner display. Without --display, take the one ax reports active.
  if [[ -z $which ]] && (( $(xcrun simctl io $UDID enumerate | grep -c 'Display class: 0') > 1 )); then
    which=$(ax state --json --device $UDID | node -e '
      console.log(JSON.parse(require("fs").readFileSync(0, "utf8")).activeDisplay.position)')
  fi
  local port
  port=$(xcrun simctl io $UDID enumerate | node -e '
    const which = process.argv[1];
    const ports = require("fs").readFileSync(0, "utf8").split(/^Port:/m)
      .filter((p) => /Display class: 0/.test(p))
      .map((p) => ({ uuid: p.match(/UUID: (\S+)/)[1],
        area: +p.match(/Default width: (\d+)/)[1] * +p.match(/Default height: (\d+)/)[1] }))
      .sort((a, b) => a.area - b.area);
    if (!ports.length) process.exit(1);
    console.log((which === "inner" ? ports[ports.length - 1] : ports[0]).uuid);
  ' "$which") || die 6 "no phone display found on $UDID"
  xcrun simctl io $UDID screenshot --display=$port $out >/dev/null 2>&1 || die 6 "simctl screenshot failed"
  say "saved $out${which:+ ($which display)}"
}

# ---- notifications -----------------------------------------------------------

HOST_BUNDLE=dev.sallvain.simdriver.runner
# A notification step's app: the shell, or with --host the runner's host app;
# ICON is its Home Screen name (the shell's CFBundleDisplayName).
TARGET=$BUNDLE ICON="My Love" IS_HOST=0
REST=()

# Takes --host out of the arguments and leaves the others in REST.
target_args() {
  REST=()
  local a
  for a in "$@"; do
    if [[ $a == --host ]]; then
      TARGET=$HOST_BUNDLE ICON=Runner IS_HOST=1
    else
      REST+=$a
    fi
  done
}

# Runs one Notify step for the target; its fields go tab-separated, since
# an icon name can hold a space.
notify() {
  require_booted
  ensure_runner
  local -a fields=($1 $TARGET "$ICON" "${@[2,-1]}")
  local code=0
  start_step Notify "${(pj:\t:)fields}" || code=$?
  finish_step Notify $1 $code
}

# Exits 2 unless FILE is JSON holding an aps object, before anything runs.
check_payload() {
  local file=$1 why
  [[ -f $file ]] || die 2 "no payload file $file"
  why=$(node -e '
    let doc;
    try { doc = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); }
    catch (e) { console.log("not JSON: " + e.message.replace(/\s+/g, " ")); process.exit(1); }
    const aps = doc && doc.aps;
    if (!aps || typeof aps !== "object" || Array.isArray(aps)) { console.log("no aps object"); process.exit(1); }
  ' $file) || die 2 "payload $file: $why"
}

cmd_permission() {
  target_args "$@"
  (( $#REST == 1 )) && [[ $REST[1] == (allow|deny|reset) ]] ||
    die 2 "permission takes allow, deny or reset (and --host)"
  [[ $REST[1] != reset ]] && { notify permission $REST[1]; return; }
  # Uninstalling drops the app's section from the device's BulletinBoard
  # VersionedSectionInfo.plist, so the reinstalled app asks again.
  local app
  if (( IS_HOST )); then
    require_booted
    ensure_runner
    app=$RUNNER/dd/Build/Products/Debug-iphonesimulator/Runner.app
  else
    app=$WORK/derived/app/Build/Products/Debug-iphonesimulator/App.app
    [[ -d $app ]] || die 1 "no shell build at $app: run sim build first"
    require_booted
  fi
  [[ -d $app ]] || die 1 "no build of $TARGET at $app"
  stage simctl-uninstall xcrun simctl uninstall $UDID $TARGET
  stage simctl-install xcrun simctl install $UDID $app
  say "reinstalled $TARGET: it has no notification permission until asked"
}

cmd_push() {
  target_args "$@"
  (( $#REST == 1 )) || die 2 "push takes FILE (and --host)"
  check_payload $REST[1]
  require_booted
  xcrun simctl push $UDID $TARGET $REST[1] >&2 || die 6 "simctl push failed"
}

# The watch must run before the push, since a banner lasts seconds and a
# runner step takes 6-12 s to start: the step goes to the background, its
# log is polled for "watching", then the push goes, then the step ends.
cmd_banner() {
  target_args "$@"
  local file=${REST[1]:-} tap= front=
  [[ -n $file ]] || die 2 "banner takes FILE [--tap cold|background | --front] (and --host)"
  if (( $#REST > 1 )); then
    if (( ${REST[(I)--front]} && ${REST[(I)--tap]} )); then
      die 2 "banner: --front and --tap cannot be combined"
    elif [[ $REST[2] == --front ]] && (( $#REST == 2 )); then
      front=1
    elif [[ $REST[2] == --tap ]] && (( $#REST == 3 )) && [[ $REST[3] == (cold|background) ]]; then
      tap=$REST[3]
    elif [[ $REST[2] == --tap ]]; then
      die 2 "banner: --tap takes cold or background"
    else
      die 2 "banner takes FILE [--tap cold|background | --front] (and --host)"
    fi
  fi
  check_payload $file
  require_booted
  ensure_runner
  local -a fields=(banner $TARGET "$ICON" ${tap:+$tap} ${front:+front})
  local log=$WORK/logs/notify.log code=0 tries=0
  # 130 for INT and 143 for TERM, as center exits.
  trap '[[ -n $STEP_PID ]] && kill $STEP_PID 2>/dev/null; exit 130' INT
  trap '[[ -n $STEP_PID ]] && kill $STEP_PID 2>/dev/null; exit 143' TERM
  BG=1 start_step Notify "${(pj:\t:)fields}"
  until grep '^NOTIFY watching' $log >/dev/null; do
    if ! kill -0 $STEP_PID 2>/dev/null; then
      wait $STEP_PID || code=$?
      finish_step Notify banner $(( code ? code : 1 ))
    fi
    if (( ++tries > 360 )); then
      kill $STEP_PID 2>/dev/null
      wait $STEP_PID || true
      die 1 "the banner watch never started (log: $log)"
    fi
    sleep 0.25
  done
  # A refused push (an app with permission denied) leaves the watch to end
  # in "no banner", which is what a check of that case looks for.
  xcrun simctl push $UDID $TARGET $file >&2 || say "simctl push failed; the watch will see no banner"
  wait $STEP_PID || code=$?
  STEP_PID=
  finish_step Notify banner $code
}

# ax state's value for one key (pose, orientation).
state_value() { ax state --device $UDID | sed -n "s/^$1: //p"; }

# Turns the device a quarter turn at a time (right through ax rotate, or left
# where Device Hub has only Rotate Left) until its orientation is WANT (at
# most four turns); folding or unfolding can change the orientation too.
# cmd_rotate can die, so it runs in a subshell and only the final check
# decides.
rotate_to() {
  local want=$1 i
  for i in 1 2 3 4; do
    [[ $(state_value orientation) == $want ]] && return 0
    ( cmd_rotate 1 ) >/dev/null 2>&1 || true
    sleep 1
  done
  [[ $(state_value orientation) == $want ]]
}

# center's way back: the pose first, then the orientation recorded at the
# start. Runs as the EXIT trap, so success, failure, SIGINT and TERM all
# restore; a restore that fails is reported and turns exit 0 into 1.
# test-center-exit.zsh checks these exit codes with ax stubbed; run it after
# changing center. ax state names the open pose "unfolded", ax pose "open".
pose_arg() { [[ $1 == unfolded ]] && print open || print $1; }
CENTER_POSE= CENTER_ORIENT= CENTER_FRONT= CENTER_MOVED=0 CENTER_SIGNAL=0 CENTER_DONE=
# CENTER_SIGNAL holds the exit code of the signal that ended center (INT
# 130, TERM 143), else 0. CENTER_DONE holds the code the restore exited with:
# the EXIT trap belongs to cmd_center and survives a restore run from a
# signal trap, so it runs the restore again on that exit, which then only
# exits.
center_restore() {
  local code=$?
  [[ -n $CENTER_DONE ]] && exit $CENTER_DONE
  (( SIM_EXIT )) && code=$SIM_EXIT
  # A second Ctrl-C must not cut the restore short.
  trap '' INT TERM
  if (( CENTER_SIGNAL )); then
    # A step still running would race the restore; end this checkout's.
    code=$CENTER_SIGNAL
    pkill -f "xcodebuild test-without-building.*$RUNNER/dd" 2>/dev/null || true
    sleep 1
  fi
  (( CENTER_MOVED )) || { CENTER_DONE=$code; exit $code; }
  local bad=0
  if [[ -n $CENTER_POSE ]] && [[ $(state_value pose) != $CENTER_POSE ]]; then
    ax pose $(pose_arg $CENTER_POSE) --device $UDID >/dev/null 2>&1 || bad=1
    sleep 1
  fi
  # ax state reports the front app's orientation, and the folded Home
  # Screen is portrait only, so a folded landscape comes back only with the
  # app that was in front (center pressed Home) brought back first.
  if [[ -n $CENTER_FRONT && $CENTER_FRONT != none ]] && [[ $(state_value orientation) != $CENTER_ORIENT ]]; then
    xcrun simctl launch $UDID $CENTER_FRONT >/dev/null 2>&1 || bad=1
    sleep 2
  fi
  rotate_to $CENTER_ORIENT 2>/dev/null || bad=1
  (( bad )) && print -u2 -- "sim: center could not restore pose ${CENTER_POSE:-none} and orientation $CENTER_ORIENT; ax state says: ${(j:, :)${(@M)${(@f)$(ax state --device $UDID 2>&1)}:#(pose|orientation):*}}"
  (( bad && code == 0 )) && code=1
  CENTER_DONE=$code
  exit $code
}

# Notification Center opens with a drag from the top of the Home Screen;
# XCUIDevice's Home press leaves the shell in front on the Duo, so Device
# Hub's Home goes before each drag, and again after, to close it. A drag can
# miss while the Home Screen settles, so it is tried three times. The Duo is
# unfolded and turned to portrait first, where 8 groups were proven to fit
# the inner display, and put back (pose, then orientation) afterwards.
cmd_center() {
  target_args "$@"
  (( $#REST == 0 )) || die 2 "center takes only --host"
  require_booted
  ensure_runner
  CENTER_POSE=$(state_value pose) CENTER_ORIENT=$(state_value orientation)
  [[ -n $CENTER_ORIENT ]] || die 5 "center: ax state has no orientation"
  # Only a start in landscape that is not unfolded (folded, or a phone with
  # no pose) needs the front app back (see center_restore); asking costs one
  # runner step, so only then.
  if [[ $CENTER_POSE != unfolded && $CENTER_ORIENT != portrait ]]; then
    local front_out front_code=0
    front_out=$(notify front 2>/dev/null) || front_code=$?
    if (( front_code )); then
      say "the front step failed (log: $WORK/logs/notify.log); the folded $CENTER_ORIENT may not come back"
    else
      CENTER_FRONT=$(print -r -- $front_out | sed -n 's/^front: //p')
      [[ -n $CENTER_FRONT && $CENTER_FRONT != none ]] ||
        say "no known app in front; the folded $CENTER_ORIENT may not come back"
    fi
  fi
  trap center_restore EXIT
  trap 'CENTER_SIGNAL=130; center_restore' INT
  trap 'CENTER_SIGNAL=143; center_restore' TERM
  CENTER_MOVED=1
  if [[ -n $CENTER_POSE && $CENTER_POSE != unfolded ]]; then
    say "unfolding (was $CENTER_POSE)"
    ax pose open --device $UDID >/dev/null || die 5 "center: could not unfold"
    sleep 1
  fi
  rotate_to portrait ||
    die 5 "center: could not turn to portrait; ax state says: pose ${$(state_value pose):-none}, orientation $(state_value orientation)"
  local out code try log=$WORK/logs/notify.log
  for try in 1 2 3; do
    ax control Home --device $UDID >/dev/null
    sleep 1
    code=0
    out=$(notify center 2>/dev/null) || code=$?
    (( code == 0 )) || ! grep 'Notification Center did not open' $log >/dev/null && break
    say "Notification Center did not open (try $try of 3)"
  done
  ax control Home --device $UDID >/dev/null
  if (( code )); then
    finish_step Notify center $code
  fi
  # The runner's warnings go to stderr, its one JSON line to stdout.
  local line
  for line in ${(f)out}; do
    if [[ $line == warning:* ]]; then say ${line#warning: }; else print -r -- $line; fi
  done
}

cmd_badge() {
  target_args "$@"
  (( $#REST == 0 )) || die 2 "badge takes only --host"
  notify badge
}

# ---- scheduled notifications ---------------------------------------------------

# The device's data folder as simctl reports it, not a hand-built
# ~/Library path (SIM_DRIVER_WORK-style overrides and device sets move it).
data_path() {
  local out
  out=$(xcrun simctl list devices -j | node -e '
    const udid = process.argv[1];
    const d = Object.values(JSON.parse(require("fs").readFileSync(0, "utf8")).devices)
      .flat().find((x) => x.udid === udid);
    if (!d || !d.dataPath) process.exit(1);
    console.log(d.dataPath);
  ' $UDID) || die 6 "simctl list devices -j has no dataPath for $UDID"
  print -r -- $out
}

# pending.py's JSON for one bundle; its notes and errors go to stderr, its
# exit code is the result (1: a record it does not recognise).
read_pending() {
  python3 -I $TOOL/pending.py $1 $2
}

cmd_pending() {
  target_args "$@"
  local bundle=$TARGET
  if (( $#REST )); then
    (( $#REST == 1 && !IS_HOST )) && [[ -n $REST[1] && $REST[1] != *[^A-Za-z0-9.-]* ]] ||
      die 2 "pending takes [BUNDLE | --host]"
    bundle=$REST[1]
  fi
  resolve_device
  # Resolved here, not inside read_pending's arguments: a die in $(...) ends
  # only that subshell and would hand pending.py an empty path.
  local dir
  dir=$(data_path) || exit $?
  read_pending $dir/Library/UserNotifications $bundle
}

# Prints FILE as one compact JSON line if it is a schedule the host can read:
# a non-empty array of {identifier, title, body, threadId, trigger}, trigger
# being {type:"interval", seconds, repeats} or {type:"calendar",
# dateComponents:{year, month, day, hour, minute, second, weekday}, repeats}.
# Otherwise prints why and exits 1. The host checks the same on its side.
check_schedule() {
  node -e '
    const fail = (why) => { console.log(why); process.exit(1); };
    let doc;
    try { doc = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); }
    catch (e) { fail("not JSON: " + e.message.replace(/\s+/g, " ")); }
    if (!Array.isArray(doc) || doc.length === 0) fail("not a non-empty array of requests");
    const plain = (x) => x && typeof x === "object" && !Array.isArray(x);
    const only = (x, keys, at) => {
      const extra = Object.keys(x).filter((k) => !keys.includes(k));
      if (extra.length) fail(`${at} has unknown ${extra.join(", ")}`);
    };
    const seen = new Set();
    doc.forEach((r, i) => {
      const at = `request ${i}`;
      if (!plain(r)) fail(`${at} is not an object`);
      for (const k of ["identifier", "title", "body", "threadId"])
        if (typeof r[k] !== "string") fail(`${at} lacks a string ${k}`);
      if (!r.identifier) fail(`${at} has an empty identifier`);
      if (!r.title && !r.body) fail(`${at} has an empty title and body, which iOS drops without an error`);
      if (seen.has(r.identifier)) fail(`${at} repeats identifier ${r.identifier}`);
      seen.add(r.identifier);
      only(r, ["identifier", "title", "body", "threadId", "trigger"], at);
      const t = r.trigger;
      if (!plain(t)) fail(`${at} lacks a trigger object`);
      if (typeof t.repeats !== "boolean") fail(`${at} trigger lacks a boolean repeats`);
      if (t.type === "interval") {
        only(t, ["type", "seconds", "repeats"], `${at} trigger`);
        if (typeof t.seconds !== "number" || !(t.seconds > 0)) fail(`${at} trigger lacks positive seconds`);
        if (t.repeats && t.seconds < 60) fail(`${at} trigger repeats under 60 seconds`);
      } else if (t.type === "calendar") {
        only(t, ["type", "dateComponents", "repeats"], `${at} trigger`);
        const c = t.dateComponents;
        if (!plain(c) || Object.keys(c).length === 0) fail(`${at} trigger lacks dateComponents`);
        only(c, ["year", "month", "day", "hour", "minute", "second", "weekday"], `${at} dateComponents`);
        for (const [k, v] of Object.entries(c))
          if (!Number.isInteger(v)) fail(`${at} dateComponents.${k} is not an integer`);
      } else {
        fail(`${at} trigger type is not interval or calendar`);
      }
    });
    console.log(JSON.stringify(doc));
  ' $1
}

# True when the pending list on stdin satisfies the wait: MODE present, with
# ARG a schedule file, needs every scheduled request listed with its title,
# body, threadId and trigger as scheduled (a same-identifier replacement is
# not done until its new content shows); MODE absent, with ARG a JSON array of
# identifiers, needs none of them listed.
pending_satisfies() {
  node -e '
    const fs = require("fs");
    const [mode, arg] = process.argv.slice(1);
    const listed = JSON.parse(fs.readFileSync(0, "utf8"));
    if (mode === "absent") {
      const gone = JSON.parse(arg);
      process.exit(listed.some((p) => gone.includes(p.identifier)) ? 1 : 0);
    }
    const want = JSON.parse(fs.readFileSync(arg, "utf8"));
    const same = require("util").isDeepStrictEqual;
    process.exit(want.every((w) => listed.some((p) => same(p, w))) ? 0 : 1);
  ' $1 $2
}

# Launches the host with REMOVE / SCHEDULE (JSON, either may be empty), reads
# the result it leaves in its Documents folder, then polls pending --host
# until MODE and ARG (see pending_satisfies) hold, so the next `sim pending`
# is consistent. The iOS daemon writes PendingNotifications.plist
# asynchronously, hence the poll.
host_apply() {
  local schedule=$1 remove=$2 mode=$3 arg=$4
  require_booted
  ensure_runner
  # Always installed: ensure_runner may have rebuilt the host since the last
  # install, and an install keeps its data and notification permission.
  local app=$RUNNER/dd/Build/Products/Debug-iphonesimulator/Runner.app
  [[ -d $app ]] || die 1 "no build of the host at $app"
  stage simctl-install xcrun simctl install $UDID $app
  local data result
  if data=$(xcrun simctl get_app_container $UDID $HOST_BUNDLE data 2>/dev/null); then
    rm -f $data/Documents/schedule-result.txt
  fi
  (
    unset SIMCTL_CHILD_SCHEDULE SIMCTL_CHILD_REMOVE
    [[ -n $schedule ]] && export SIMCTL_CHILD_SCHEDULE=$schedule
    [[ -n $remove ]] && export SIMCTL_CHILD_REMOVE=$remove
    xcrun simctl launch --terminate-running-process $UDID $HOST_BUNDLE >/dev/null
  ) || die 6 "could not launch the host ($HOST_BUNDLE)"
  data=$(xcrun simctl get_app_container $UDID $HOST_BUNDLE data) ||
    die 6 "no data container for $HOST_BUNDLE"
  result=$data/Documents/schedule-result.txt
  local deadline=$(( SECONDS + 30 ))
  until [[ -f $result ]]; do
    (( SECONDS < deadline )) || die 1 "the host wrote no result in 30 s (is it running? launch it by hand and look)"
    sleep 0.25
  done
  local line=$(<$result)
  case $line in
    ok) ;;
    "not authorized") die 1 "the host has no notification permission: run sim permission allow --host" ;;
    *) die 1 "the host refused: $line" ;;
  esac
  # The file is replaced while the daemon writes it, so a read that fails or
  # does not yet match is tried again until the deadline; the last read (or
  # its failure) is reported.
  local dir out errlog=$WORK/logs/pending.err
  dir=$(data_path) || exit $?
  mkdir -p $WORK/logs
  deadline=$(( SECONDS + 20 ))
  until out=$(read_pending $dir/Library/UserNotifications $HOST_BUNDLE 2>$errlog) && print -r -- $out | pending_satisfies $mode $arg; do
    if (( SECONDS >= deadline )); then
      local why=$(<$errlog)
      die 1 "pending --host did not show the change in 20 s; last read: ${out:-nothing}${why:+ ($why)}"
    fi
    sleep 0.5
  done
}

cmd_schedule() {
  (( $# == 1 )) || die 2 "schedule takes FILE"
  [[ -f $1 ]] || die 2 "no schedule file $1"
  local json
  json=$(check_schedule $1) || die 2 "schedule $1: $json"
  host_apply "$json" "" present "$1"
  say "scheduled $(print -r -- $json | node -e 'console.log(JSON.parse(require("fs").readFileSync(0, "utf8")).length)') request(s) on the host"
}

cmd_unschedule() {
  (( $# )) || die 2 "unschedule takes one or more identifiers"
  local ids
  ids=$(node -e 'console.log(JSON.stringify(process.argv.slice(1)))' -- "$@")
  host_apply "" "$ids" absent "$ids"
  say "asked the host to remove $# identifier(s); none is pending on it now"
}

# ---- main --------------------------------------------------------------------

args=()
while (( $# )); do
  case $1 in
    --device) DEVICE_ARG=${2:?--device needs a UDID or name}; shift 2 ;;
    *) args+=$1; shift ;;
  esac
done
set -- "${args[@]}"
(( $# )) || { usage; exit 2; }
cmd=$1; shift

case $cmd in
  help|-h|--help) usage ;;
  provision) cmd_provision ;;
  dates) cmd_dates "$@" ;;
  build) cmd_build "$@" ;;
  serve-update) cmd_serve_update "$@" ;;
  signin) cmd_signin "$@" ;;
  signout) (( $# == 0 )) || die 2 "signout takes nothing"; drive signout ;;
  pose)
    [[ ${1:-} == (closed|partial|open) ]] || die 2 "pose takes closed, partial or open"
    require_booted; ax pose $1 --device $UDID ;;
  rotate)
    [[ -z ${1:-} || $1 == <1-9> ]] || die 2 "rotate takes a count from 1 to 9"
    require_booted; cmd_rotate ${1:-1} ;;
  state) require_booted; ax state --device $UDID ;;
  tap)
    [[ $# == 2 && $1 == <->(|.<->) && $2 == <->(|.<->) ]] || die 2 "tap takes X Y in page points"
    drive tap $1 $2 ;;
  scroll)
    [[ ${1:-} == (up|down) ]] || die 2 "scroll takes up or down"
    drive scroll $1 ;;
  dump) drive dump ;;
  readout) cmd_readout ;;
  background) require_booted; ax control Home --device $UDID >/dev/null; say "pressed Home" ;;
  launch) require_booted; xcrun simctl launch $UDID $BUNDLE >/dev/null; say "launched $BUNDLE" ;;
  screenshot) cmd_screenshot "$@" ;;
  uninstall) require_booted; xcrun simctl uninstall $UDID $BUNDLE; say "uninstalled $BUNDLE" ;;
  permission) cmd_permission "$@" ;;
  push) cmd_push "$@" ;;
  banner) cmd_banner "$@" ;;
  center) cmd_center "$@" ;;
  badge) cmd_badge "$@" ;;
  pending) cmd_pending "$@" ;;
  schedule) cmd_schedule "$@" ;;
  unschedule) cmd_unschedule "$@" ;;
  *) usage >&2; die 2 "unknown command $cmd" ;;
esac
