# .env.test
# Local Supabase values for E2E testing (Playwright)
#
# Vite loads this file when run with --mode test.
# These plain-text values point Vite at local Supabase; the encrypted
# production credentials live in fnox.toml and reach Vite only through
# `fnox exec --`.
#
# These are standard local Supabase dev-server values (deterministic,
# generated by `supabase start`). Safe to commit.
#
# Keep this value as a non-secret placeholder. Real local keys should come
# from `supabase start` output or uncommitted environment overrides.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH