{
  "name": "my-love",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev-with-cleanup.sh",
    "dev:raw": "vite",
    "dev:local": "vite --mode test",
    "supabase:up": "supabase start",
    "supabase:down": "supabase stop",
    "build": "tsc -p tsconfig.app.json && vite build",
    "ios:sync": "npm run build && cap sync ios",
    "perf:build": "mkdir -p test-results/performance && npm run typecheck && { vite build > test-results/performance/perf-build.log 2>&1; status=$?; cat test-results/performance/perf-build.log; exit $status; }",
    "perf:bundle-report": "npm run perf:build && node scripts/perf-bundle-report.mjs",
    "typecheck": "tsc -b --force",
    "lint": "eslint src tests scripts --no-error-on-unmatched-pattern --ignore-pattern 'tests/playwright-report/**' --ignore-pattern 'tests/test-results/**' --ignore-pattern 'playwright-report/**' --ignore-pattern 'test-results/**' --ignore-pattern '_bmad-output/**' --ignore-pattern '_bmad/**' --ignore-pattern '.codex/**'",
    "preview": "npx vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage --sequence.shuffle",
    "test:smoke": "node scripts/smoke-tests.cjs",
    "test:e2e": "./scripts/test-with-cleanup.sh",
    "test:e2e:raw": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:integration": "playwright test --project=integration",
    "test:p0": "playwright test --grep '\\[P0\\]'",
    "test:p1": "playwright test --grep '\\[P0\\]|\\[P1\\]'",
    "test:burn-in": "bash scripts/burn-in.sh",
    "test:db": "supabase test db",
    "test:failures": "playwright test --reporter=json 2>/dev/null | node scripts/pw-failures.mjs /dev/stdin",
    "test:ci-local": "bash scripts/ci-local.sh",
    "lint:fix": "eslint src tests scripts --fix --no-error-on-unmatched-pattern --ignore-pattern 'tests/playwright-report/**' --ignore-pattern 'tests/test-results/**' --ignore-pattern 'playwright-report/**' --ignore-pattern 'test-results/**' --ignore-pattern '_bmad-output/**' --ignore-pattern '_bmad/**' --ignore-pattern '.codex/**'",
    "deadcode": "bash scripts/deadcode.sh"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capgo/capacitor-updater": "^8.54.0",
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "^2.5.0",
    "react-window-infinite-loader": "^2.0.2",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@seontechnologies/playwright-utils": "^4.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.152.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "glob": "^12.0.0",
    "tar": "^7.5.8",
    "js-yaml": "^4.2.0",
    "serialize-javascript": "^7.0.5",
    "picomatch@^2.0.0": "^2.3.2",
    "picomatch@^4.0.0": "^4.0.4",
    "adm-zip": "^0.6.0",
    "ws": "^8.21.0",
    "fast-uri": "^3.1.5",
    "tmp": "^0.2.6",
    "flatted": "^3.4.2",
    "brace-expansion@^5.0.0": "^5.0.8",
    "brace-expansion@^1.0.0": "^1.1.16",
    "brace-expansion@^2.0.0": "^2.1.4",
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "lodash": "^4.18.1",
    "uuid@^8.0.0": "^11.1.1",
    "uuid@^11.0.0": "^11.1.1",
    "uuid@^13.0.0": "^13.0.2"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "maintained node versions"
  ],
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": true,
    "@seontechnologies/playwright-utils": false
  }
}
