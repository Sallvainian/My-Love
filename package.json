{
  "name": "my-love",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev-with-cleanup.sh",
    "dev:raw": "vite",
    "dev:local": "vite --mode test",
    "supabase:up": "npx supabase start",
    "supabase:down": "npx supabase stop",
    "build": "tsc -p tsconfig.app.json && vite build",
    "perf:build": "mkdir -p docs/performance && npm run typecheck && vite build 2>&1 | tee docs/performance/perf-build.log",
    "perf:bundle-report": "npm run perf:build && node scripts/perf-bundle-report.mjs",
    "typecheck": "tsc -b --force",
    "lint": "eslint src tests scripts --no-error-on-unmatched-pattern --ignore-pattern 'tests/playwright-report/**' --ignore-pattern 'tests/test-results/**' --ignore-pattern 'playwright-report/**' --ignore-pattern 'test-results/**' --ignore-pattern '_bmad-output/**' --ignore-pattern '_bmad/**' --ignore-pattern '.codex/**'",
    "preview": "npx vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/smoke-tests.cjs",
    "test:e2e": "./scripts/test-with-cleanup.sh",
    "test:e2e:raw": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:integration": "playwright test --project=integration",
    "test:p0": "playwright test --grep '\\[P0\\]'",
    "test:p1": "playwright test --grep '\\[P0\\]|\\[P1\\]'",
    "test:burn-in": "bash scripts/burn-in.sh",
    "test:db": "supabase test db",
    "test:failures": "playwright test --reporter=json 2>/dev/null | node scripts/pw-failures.mjs /dev/stdin",
    "test:ci-local": "bash scripts/ci-local.sh",
    "predeploy": "npm run build && npm run test:smoke",
    "deploy": "gh-pages -d dist",
    "postdeploy": "echo 'Deployment complete! Run: node scripts/post-deploy-check.cjs [YOUR_URL]'",
    "lint:fix": "eslint src tests scripts --fix --no-error-on-unmatched-pattern --ignore-pattern 'tests/playwright-report/**' --ignore-pattern 'tests/test-results/**' --ignore-pattern 'playwright-report/**' --ignore-pattern 'test-results/**' --ignore-pattern '_bmad-output/**' --ignore-pattern '_bmad/**' --ignore-pattern '.codex/**'",
    "deadcode": "bash scripts/deadcode.sh"
  },
  "dependencies": {
    "@sentry/react": "^10.68.0",
    "@supabase/supabase-js": "^2.110.8",
    "dompurify": "^3.4.12",
    "eventsource": "^4.1.0",
    "framer-motion": "^12.42.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "react-window-infinite-loader": "^2.0.1",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@seontechnologies/playwright-utils": "^3.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^2.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.23",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "^7.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "glob": "^12.0.0",
    "tar": "^7.5.8",
    "js-yaml": "^4.2.0",
    "serialize-javascript": "^7.0.5",
    "picomatch@^2.0.0": "^2.3.2",
    "picomatch@^4.0.0": "^4.0.4",
    "adm-zip": "^0.6.0",
    "ws": "^8.21.0",
    "fast-uri": "^3.1.3",
    "tmp": "^0.2.6",
    "flatted": "^3.4.2",
    "brace-expansion@^5.0.0": "^5.0.8",
    "brace-expansion@^1.0.0": "^1.1.16",
    "brace-expansion@^2.0.0": "^2.1.2",
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "lodash": "^4.18.1",
    "uuid@^8.0.0": "^11.1.1",
    "uuid@^11.0.0": "^11.1.1",
    "uuid@^13.0.0": "^13.0.2"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "maintained node versions"
  ]
}
